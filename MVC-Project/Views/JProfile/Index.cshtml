@{
    ViewData["Title"] = "Profile Ni Joanna";
    ViewData["BodyClass"] = "profile-page";
    MVC_Project.Models.JProfileViewModel profile = Model;
}

@* ------------------------------------------------------------------ Section 1 - Title  *@
<div class="jcontainer" style="background-color: #8ddbc4;">
@* About Joanna Titles Section 1.1: name with titles *@
    <div class="intro-name">
      <h1><b>@profile.Name</b>, a</h1>
      <p>@string.Join(" · ", (List<string>)ViewBag.Titles)</p>
    </div>

@* Favorite Quotes Section 1.2: quote blocks that alternates positions*@

    <div class="quotes-section">
        @foreach (dynamic q in ViewBag.Quotes)
        {
            <div class="quote-item">
                <blockquote>
                    <i>@q.Quote</i>
                <footer>- @q.Author</footer>
                </blockquote>
            </div>
        }
    </div>
</div>

@* ------------------------------------------------------------------ Section 2 - Infoboxes  *@
<div class="jcontainer" style="background-color: wheat;">
    <div class="group">
        @* General Info Box Section 2.1: in a 5x1 line table *@

        <div class="general-infobox" style="background-color: whitesmoke">
            <table>
                <tr><th colspan="2">General Information</th></tr>
                <tr><th colspan="2">
                        <img src="~/Joanna.jpg" alt="Me" class="infobox-img">
                    </th></tr>
                <tr>
                    <td>Name</td>
                    <td>@profile.Name</td>
                </tr>
                <tr>
                    <td>Major</td>
                    <td>@profile.Major</td>
                </tr>
                <tr>
                    <td>Education</td>
                    <td>@profile.Education</td>
                </tr>
                <tr>
                    <td>Languages</td>
                    <td>@string.Join(", ", profile.Languages)</td>
                </tr>
                <tr>
                    <td>Programming Languages</td>
                    <td>@string.Join(", ", profile.PLanguages)</td>
                </tr>
            </table>
        </div>

        <div class="current-section">
            @* Status Section 2.2.1: big section for currently learning *@
            <div class="status-section">
                <h3>Currently Learning:</h3>
                <br />
                <span>@ViewBag.Status</span>
            </div>

            @* Interests Section 2.2.2: list of interests *@
            <div class="interests-section">
                <h3>Interests</h3>
                @foreach (var i in profile.Interests)
                    {
                        <div class = interest-item>
                            <span>
                                @i.Interest
                            </span>
                            <ul>
                                @foreach (string detail in i.Details)
                                {
                                    <li>@detail</li>
                                }
                            </ul>
                        </div>
                    }
            </div>
        </div>
    </div>
</div>

@* ------------------------------------------------------------------ Section 3 - Project Gallery  *@
<div class="jcontainer" style="background-color: #2d2030;">
    <div class="project-gallery">
        <h3 style="text-align: center; color: whitesmoke"><b>Project Gallery</b></h3> <br />
        @foreach (var p in profile.Projects)
        {
            <div class="project-item">
                <h4><b>@p.ProjectTitle</b></h4>
                <div class="project-tags">
                    <span class="badge rounded-pill text-bg-success">@p.Context</span>
                    <span class="badge rounded-pill text-bg-success">@(p.TeamName != "" ? p.TeamName + ", " : "")Team of @p.TeamSize</span>
                </div>
                <p><b>Technologies: </b> @string.Join(", ", p.Technologies)</p>
                <p><b>Description: </b> @p.ProjDescription</p>
            </div>
        }
    </div>
</div>

<style>
    .infobox-img {
    width: 100%;
    height: auto;
    border: 2px solid rgb(45, 32, 48);
}
</style>
